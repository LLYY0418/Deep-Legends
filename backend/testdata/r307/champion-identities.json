{"1":{"riotId":"Annie","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.05}],"abilityChanges":[]}},"2":{"riotId":"Olaf","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05}],"abilityChanges":[]}},"3":{"riotId":"Galio","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.1},{"key":"damageTaken","unit":"percent","value":0.05}],"abilityChanges":[]}},"4":{"riotId":"TwistedFate","balance":{}},"5":{"riotId":"XinZhao","balance":{}},"6":{"riotId":"Urgot","balance":{}},"7":{"riotId":"Leblanc","balance":{"modifiers":[{"key":"abilityHaste","unit":"number","value":20},{"key":"damageDealt","unit":"percent","value":0.1},{"key":"damageTaken","unit":"percent","value":-0.1}],"abilityChanges":[]}},"8":{"riotId":"Vladimir","balance":{}},"9":{"riotId":"FiddleSticks","balance":{}},"10":{"riotId":"Kayle","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.05},{"key":"damageTaken","unit":"percent","value":0.1}],"abilityChanges":[]}},"11":{"riotId":"MasterYi","balance":{}},"12":{"riotId":"Alistar","balance":{"modifiers":[{"key":"damageTaken","unit":"percent","value":0.05}],"abilityChanges":[]}},"13":{"riotId":"Ryze","balance":{}},"14":{"riotId":"Sion","balance":{"modifiers":[{"key":"abilityHaste","unit":"number","value":-10},{"key":"damageDealt","unit":"percent","value":-0.1}],"abilityChanges":[{"ability":"死亡荣耀","key":"P","description":"在被击杀后，赛恩会回光返照一段时间并且生命值会快速衰减。在此期间，他的攻击会变得超快，获得生命偷取，并且每次攻击会额外造成基于目标最大生命值的额外伤害。","lines":["生命偷取改为 50%（原为 100%）。"]},{"ability":"灵魂熔炉","key":"W","description":"赛恩为自己套上护盾，并能在3秒后再次激活这个技能来对身边的敌人造成魔法伤害。在赛恩击杀敌人时，他会被动获得最大生命值。","lines":["赛恩每击杀一个单位就会获得最大生命值改为 3（原为 4）。","在参与击杀英雄、击杀大型小兵或大型野怪后获得最大生命值改为 8（原为 15）。","最大生命值收益系数改为 6 / 7 / 8 / 9 / 10%（原为 8 / 10 / 12 / 14 / 16%）。"]}]}},"15":{"riotId":"Sivir","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.07},{"key":"damageTaken","unit":"percent","value":0.05}],"abilityChanges":[{"ability":"回旋之刃","key":"Q","description":"希维尔像挥舞回力标一样挥出她的十字刃，并在往返时造成伤害。","lines":["冷却时间改为 14 / 13 / 12 / 11 / 10（原为 10 / 9.5 / 9 / 8.5 / 8）。"]}]}},"16":{"riotId":"Soraka","balance":{"modifiers":[{"key":"abilityHaste","unit":"number","value":10}],"abilityChanges":[{"ability":"流星坠落","key":"Q","description":"一颗流星从天而降，落在目标地点，造成魔法伤害，并对区域中心的敌人造成减速效果。如果一名敌人被此技能命中，那么索拉卡就会回复生命值。","lines":["生命回复(活力焕发)改为 75 / 90 / 105 / 120 / 135（原为 60 / 75 / 90 / 105 / 120）。","法术强度系数改为 40%（原为 30%）。"]},{"ability":"星之灌注","key":"W","description":"索拉卡牺牲自己的一部分生命值来治疗一个友方英雄。","lines":["那么生命值消耗会降低改为 5%（原为 10%）。"]}]}},"17":{"riotId":"Teemo","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.05},{"key":"damageTaken","unit":"percent","value":0.1}],"abilityChanges":[{"ability":"种蘑菇","key":"R","description":"提莫投掷一个可爆炸的毒性陷阱，需要消耗提莫背包里的一个蘑菇。陷阱会在被敌方踩中时爆炸，释放出一团毒云，对附近的敌人造成减速效果和持续伤害。如果提莫把一个蘑菇扔到另一个蘑菇上，那么这个蘑菇会进行弹跳，获得额外的距离。","lines":["减速改为 20%（原为 30 / 40 / 50%）。","持续时间改为 3（原为 5）。","伤害改为 180 / 290 / 400（原为 200 / 325 / 450）。","法术强度系数改为 40%（原为 50%）。"]}]}},"18":{"riotId":"Tristana","balance":{}},"19":{"riotId":"Warwick","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05},{"key":"damageTaken","unit":"percent","value":-0.05}],"abilityChanges":[{"ability":"野兽之口","key":"Q","description":"沃里克向前猛扑并撕咬他的目标，造成基于目标最大生命值的伤害，并造成基于实际伤害值的治疗效果。","lines":["冷却时间改为 6（原为 8 / 7.5 / 7 / 6.5 / 6）。"]}]}},"20":{"riotId":"Nunu","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.1},{"key":"damageTaken","unit":"percent","value":-0.1},{"key":"healing","unit":"percent","value":0.1},{"key":"shielding","unit":"percent","value":0.2},{"key":"tenacity","unit":"percent","value":0.2}],"abilityChanges":[{"ability":"吞噬","key":"Q","description":"威朗普撕咬一个小兵、野怪或敌方英雄，造成巨大伤害并回复自己的生命值。","lines":["法术强度系数改为 110%（原为 90%）。"]},{"ability":"史上最大雪球！","key":"W","description":"威朗普滚起一个雪球，它的尺寸和速度将随着滚动时间而增长。雪球会伤害并击飞敌人。","lines":["法术强度系数改为 200%（原为 150%）。"]}]}},"21":{"riotId":"MissFortune","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.05}],"abilityChanges":[]}},"22":{"riotId":"Ashe","balance":{"modifiers":[],"abilityChanges":[{"ability":"万箭齐发","key":"W","description":"艾希向前方的锥形范围射出多支箭，对敌人造成额外伤害。也会触发冰霜射击的效果。","lines":["冷却时间改为 18 / 17 / 16 / 15 / 14（原为 18 / 14.5 / 11 / 7.5 / 4）。"]}]}},"23":{"riotId":"Tryndamere","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.1},{"key":"damageTaken","unit":"percent","value":-0.1},{"key":"healing","unit":"percent","value":0.2}],"abilityChanges":[]}},"24":{"riotId":"Jax","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05},{"key":"damageTaken","unit":"percent","value":-0.03}],"abilityChanges":[]}},"25":{"riotId":"Morgana","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.05}],"abilityChanges":[]}},"26":{"riotId":"Zilean","balance":{"modifiers":[],"abilityChanges":[{"ability":"瓶中时光","key":"P","description":"基兰将时光储存为经验值并能将其提供给他的友军。当他拥有足够的经验值来使一名友方英雄升级时，他就能通过右键点击来传授经验值。基兰自身也会获得等值的经验值。","lines":["冷却时间改为 90（原为 120）。"]},{"ability":"穿梭未来","key":"W","description":"基兰为未来的对抗做准备，减少他所有其它基础技能的冷却时间。","lines":["冷却时间改为 13 / 11 / 9 / 7 / 5（原为 14 / 12 / 10 / 8 / 6）。"]},{"ability":"时光发条","key":"E","description":"基兰扭曲任意单位的时光，短时间内提升友方单位移动速度或减少敌方单位移动速度。","lines":["冷却时间改为 13（原为 15）。"]},{"ability":"时光倒流","key":"R","description":"基兰对友方英雄施放时光结界，若目标死亡，则时光倒流，救活目标。","lines":["法术强度系数改为 250%（原为 200%）。"]}]}},"27":{"riotId":"Singed","balance":{"modifiers":[],"abilityChanges":[{"ability":"剧毒冲流","key":"P","description":"辛吉德借助附近英雄进行漂移，在经过他们时获得爆发性的移动速度加成。","lines":["移动速度改为 20%（原为 25%）。","冷却时间改为 10（原为 8）。"]}]}},"28":{"riotId":"Evelynn","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.1},{"key":"damageTaken","unit":"percent","value":-0.1},{"key":"tenacity","unit":"percent","value":0.2}],"abilityChanges":[{"ability":"最终抚慰","key":"R","description":"伊芙琳短暂进入不可被选取状态并大肆残杀她面前区域内的敌人，然后向后位移一大段距离。","lines":["冷却时间改为 100 / 80 / 60（原为 120 / 100 / 80）。"]}]}},"29":{"riotId":"Twitch","balance":{}},"30":{"riotId":"Karthus","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.07},{"key":"damageTaken","unit":"percent","value":0.05}],"abilityChanges":[{"ability":"死亡契约","key":"P","description":"在死亡时，卡尔萨斯会化为一个灵体，能够继续施放技能。","lines":["持续时间改为 5（原为 7）。"]}]}},"31":{"riotId":"Chogath","balance":{"modifiers":[{"key":"damageTaken","unit":"percent","value":-0.05}],"abilityChanges":[]}},"32":{"riotId":"Amumu","balance":{}},"33":{"riotId":"Rammus","balance":{}},"34":{"riotId":"Anivia","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05}],"abilityChanges":[]}},"35":{"riotId":"Shaco","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05}],"abilityChanges":[{"ability":"背刺","key":"P","description":"在目标的背后时，萨科的普攻和【E双面毒刃】会造成额外伤害。","lines":["额外攻击力系数改为 40%（原为 20%）。"]},{"ability":"欺诈魔术","key":"Q","description":"萨科进入隐形状态并传送到目标位置。 他在隐形状态下的第一次普攻将获得增强，造成额外伤害并在目标背后攻击时必定会暴击。","lines":["冷却时间改为 12 / 11 / 10 / 9 / 8（原为 13 / 12.5 / 12 / 11.5 / 11）。","额外攻击力系数改为 85%（原为 60%）。"]},{"ability":"惊吓魔盒","key":"W","description":"萨科丢出一个隐形且会动的惊吓魔盒。在触发时，盒子会恐惧附近的敌人，然后对其进行攻击。","lines":["最大陷阱数改为 6。"]},{"ability":"双面毒刃","key":"E","description":"萨科的毒刃在命中时会被动地使目标中毒，减少目标的移动速度。他可以将毒刃扔向目标，造成伤害和中毒效果。扔出的毒刃会对生命值低于30%的目标造成额外伤害。","lines":["额外攻击力系数改为 100%（原为 80%）。"]}]}},"36":{"riotId":"DrMundo","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.1},{"key":"damageTaken","unit":"percent","value":0.05},{"key":"healing","unit":"percent","value":-0.1}],"abilityChanges":[]}},"37":{"riotId":"Sona","balance":{"modifiers":[],"abilityChanges":[{"ability":"能量和弦","key":"P","description":"渐入佳音：娑娜在出色地使用她的技能时，会获得非终极技能的技能急速，直到达到上限为止。在达到上限之后，后续的成功使用将转而缩短她终极技能的冷却时间。 能量和弦：每施放若干次技能，娑娜的下次攻击将造成额外魔法伤害并基于最新激活的基础技能施加一个额外效果。","lines":["基础技能急速改为 30（原为 60）。","转而使她当前的终极技能冷却时间缩短改为 1（原为 1.5）。"]},{"ability":"英勇赞美诗","key":"Q","description":"娑娜弹奏英勇赞美诗，弹出音波，对附近的两名敌人造成魔法伤害，优先选取英雄和野怪为目标。娑娜会暂时获得一个光环，为附近友军的下一次攻击提供额外魔法伤害。","lines":["冷却时间改为 10（原为 8）。"]},{"ability":"坚毅咏叹调","key":"W","description":"娑娜弹奏坚毅咏叹调，弹出保护性的旋律，治疗娑娜和附近的一个受伤的友军。娑娜会暂时获得一个光环，为附近的友军提供一层护盾。","lines":["护盾(旋律)改为 65 / 75 / 85 / 95 / 105（原为 25 / 45 / 65 / 85 / 105）。","治疗效果改为 20%（原为 30%）。","冷却时间改为 13（原为 10）。"]}]}},"38":{"riotId":"Kassadin","balance":{"modifiers":[{"key":"damageTaken","unit":"percent","value":-0.05}],"abilityChanges":[{"ability":"能量脉冲","key":"E","description":"附近有单位施放法术技能时，卡萨丁将吸收能量，当充能完毕后，吸收的能量可转化为脉冲，对面前锥形区域内敌人造成伤害并减速。","lines":["伤害改为 80 / 115 / 150 / 185 / 220（原为 70 / 100 / 130 / 160 / 190）。","法术强度系数改为 75%（原为 70%）。"]}]}},"39":{"riotId":"Irelia","balance":{"modifiers":[{"key":"abilityHaste","unit":"number","value":20},{"key":"damageDealt","unit":"percent","value":0.05}],"abilityChanges":[]}},"40":{"riotId":"Janna","balance":{"modifiers":[],"abilityChanges":[{"ability":"飓风呼啸","key":"Q","description":"迦娜改变气压和温度，在目标区域召唤小型风暴，风暴体积随时间增大。她可以再次施放该技能来释放风暴。风暴会朝向施放方向飞行，对沿途的所有单位造成伤害和击飞效果。","lines":["冷却时间改为 16（原为 14）。"]}]}},"41":{"riotId":"Gangplank","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05}],"abilityChanges":[]}},"42":{"riotId":"Corki","balance":{"modifiers":[{"key":"abilityHaste","unit":"number","value":-20},{"key":"damageTaken","unit":"percent","value":-0.05}],"abilityChanges":[]}},"43":{"riotId":"Karma","balance":{"modifiers":[],"abilityChanges":[{"ability":"梵咒","key":"R","description":"卡尔玛的下个技能会获得强化，造成额外特效。梵咒在1级时就可以使用，并且不需要投入技能点。","lines":["灵光闪耀 冲击伤害改为 40 / 90 / 140 / 190（原为 40 / 100 / 160 / 220）。"]}]}},"44":{"riotId":"Taric","balance":{"modifiers":[{"key":"damageTaken","unit":"percent","value":0.1}],"abilityChanges":[]}},"45":{"riotId":"Veigar","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.07},{"key":"damageTaken","unit":"percent","value":0.1}],"abilityChanges":[{"ability":"超凡邪力","key":"P","description":"维迦是最强大的恶魔，甚至能对符文之地之心发起攻击——并且他只会越来越强大！用技能攻击一名敌人、击杀单位或拆毁防御塔都会为维迦永久提升法术强度加成。","lines":["参与击杀英雄后会提供额外的层数改为 3（原为 5）。"]},{"ability":"扭曲空间","key":"E","description":"维迦扭曲空间的边缘，创造一个牢笼来使途径的敌人晕眩。","lines":["冷却时间改为 23 / 21.5 / 20 / 18.5 / 17（原