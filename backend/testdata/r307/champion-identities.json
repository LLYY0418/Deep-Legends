 / 21 / 20 / 19 / 18）。"]},{"ability":"大闹天宫","key":"R","description":"孙悟空伸展金箍棒不断旋转，并获得移动速度。 击中敌人时会造成伤害和击飞效果。","lines":["冷却时间改为 140 / 120 / 100（原为 130 / 110 / 90）。"]}]}},"63":{"riotId":"Brand","balance":{"modifiers":[{"key":"abilityHaste","unit":"number","value":-10},{"key":"damageDealt","unit":"percent","value":-0.05},{"key":"damageTaken","unit":"percent","value":0.1}],"abilityChanges":[]}},"64":{"riotId":"LeeSin","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05},{"key":"damageTaken","unit":"percent","value":-0.05},{"key":"energyRegen","unit":"percent","value":0.2},{"key":"healing","unit":"percent","value":0.1},{"key":"shielding","unit":"percent","value":0.2}],"abilityChanges":[]}},"67":{"riotId":"Vayne","balance":{}},"68":{"riotId":"Rumble","balance":{}},"69":{"riotId":"Cassiopeia","balance":{}},"72":{"riotId":"Skarner","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.05},{"key":"damageTaken","unit":"percent","value":-0.05}],"abilityChanges":[]}},"74":{"riotId":"Heimerdinger","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":-0.1},{"key":"damageTaken","unit":"percent","value":0.1}],"abilityChanges":[]}},"75":{"riotId":"Nasus","balance":{"modifiers":[],"abilityChanges":[{"ability":"汲魂痛击","key":"Q","description":"内瑟斯对敌人施放汲魂痛击造成伤害，如果敌人死于汲魂痛击，则永久增加下次汲魂痛击的伤害。","lines":["会使其伤害永久提升改为 6（原为 4）。","击杀英雄、大型小兵和大型野怪的伤害提升改为 24（原为 10）。"]}]}},"76":{"riotId":"Nidalee","balance":{"modifiers":[{"key":"damageDealt","unit":"percent","value":0.1}],"abilityChanges":[]}},"77":{"riotId":"Udyr","balance":{}},"78":{"riotId":"Poppy","balance":{}},"79":{"riotId":"Gragas","balance":{"modifiers":[{"key":"damageTaken","unit":"percent","value":-0.05}],"abilityChanges":[]}},"80":{"riotId":"Pantheon","balance":{}},"81":{"riotId":"Ezreal","balance":{}},"82":{"riotId":"Mordekaiser","balance":{}},"83":{"riotId":"Yorick","balance":{"modifiers":[],"abilityChanges":[{"ability":"临终仪式","key":"Q","description":"约里克的下次攻击造成额外伤害并治疗自身。如果目标是一个英雄或大